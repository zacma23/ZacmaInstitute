# ============================================================================
# ZACMA TECHNOLOGY & TRAINING INSTITUTE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env (never commit real secrets to GitHub).
# ============================================================================

# --- Server-Side Gemini AI Assistant (Required for ZACMA AI ASSISTANT) ---
# Must remain strictly server-side; never prefix with VITE_.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# --- Application Runtime ---
APP_URL="http://localhost:3000"
PORT="3000"

# --- Cron Job Authentication (Vercel Cron -> /api/cron/reminders) ---
CRON_SECRET="CHANGE_ME_RANDOM_SECRET"

# --- Optional: Use Your Own Firebase Project on Vercel ---
# Leave blank to use the bundled firebase-applet-config.json (project gen-lang-client-0608981624).
# If you added your Vercel domain to YOUR OWN Firebase project, set these in Vercel & redeploy:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# --- Optional External Supabase PostgreSQL Target (For GitHub -> Vercel -> Supabase) ---
# Set these in Vercel Project Settings -> Environment Variables when deploying to Supabase.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Optional External Notification Channel Adapters ---
# Leave blank if using In-App Notifications only. Channels will honestly report "Not Configured".
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ZACMA Finance <finance@zacma.edu.et>"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
