        "replyToPreview": { "type": "string", "maxLength": 200 },
        "attachmentName": { "type": "string", "maxLength": 160 },
        "attachmentType": { "type": "string", "maxLength": 100 },
        "attachmentSize": { "type": "number" },
        "attachmentDataUrl": { "type": "string", "maxLength": 650000 },
        "readByUids": { "type": "array", "description": "Bounded UIDs that have read this message." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "senderId", "senderName", "senderRole", "body", "readByUids", "createdAt"]
    },
