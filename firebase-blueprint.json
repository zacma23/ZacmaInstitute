{
  "entities": {
    "Role": {
      "title": "Role",
      "description": "Canonical staff and student role definition in ZACMA portal.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "enum": ["ADMIN", "ACCOUNTANT", "INSTRUCTOR", "GENERAL_STAFF", "STUDENT"], "maxLength": 20 },
        "name": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 300 },
        "permissions": { "type": "array", "description": "Bounded list of role capabilities." }
      },
      "required": ["code", "name", "description"]
    },
    "Profile": {
      "title": "Profile",
      "description": "Authenticated user profile and authoritative RBAC role assignment.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "fullName": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["ADMIN", "ACCOUNTANT", "INSTRUCTOR", "GENERAL_STAFF", "STUDENT"] },
        "linkedStudentId": { "type": "string", "maxLength": 128 },
        "allowedModules": { "type": "array", "description": "Optional granular module allowlist for General Staff." },
        "canExportReports": { "type": "boolean", "description": "Explicit Admin authorization allowing an Accountant to export financial Excel reports." },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "role", "isActive", "createdAt", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "ZACMA training course with fee, duration, schedule, and assigned instructor.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 24, "pattern": "^[A-Z0-9\\-]+$" },
        "name": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 80 },
        "durationWeeks": { "type": "number" },
        "feeEtb": { "type": "number" },
        "schedule": { "type": "string", "maxLength": 120 },
        "instructorId": { "type": "string", "maxLength": 128 },
        "instructorName": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "name", "category", "durationWeeks", "feeEtb", "schedule", "isActive", "createdAt", "updatedAt"]
    },
    "PaymentPlan": {
      "title": "PaymentPlan",
      "description": "Standard or custom installment payment plan template.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "enum": ["FULL", "MONTHLY", "TWO_MONTH", "THREE_MONTH", "SIX_MONTH", "CUSTOM"], "maxLength": 30 },
        "name": { "type": "string", "maxLength": 80 },
        "installmentCount": { "type": "number" },
        "intervalDays": { "type": "number" },
        "description": { "type": "string", "maxLength": 240 },
        "isActive": { "type": "boolean" }
      },
      "required": ["code", "name", "installmentCount", "intervalDays", "isActive"]
    },
    "Student": {
      "title": "Student",
      "description": "Registered student profile with institutional ID and admin approval status.",
      "type": "object",
      "properties": {
        "studentCode": { "type": "string", "maxLength": 24, "pattern": "^ZAC-[0-9]{4}-[0-9]{4}$" },
        "fullName": { "type": "string", "maxLength": 120 },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "phone": { "type": "string", "maxLength": 30 },
        "altPhone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 240 },
        "photoUrl": { "type": "string", "maxLength": 90000 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseName": { "type": "string", "maxLength": 120 },
        "enrollmentDate": { "type": "string", "maxLength": 20 },
        "registrationDateEthiopian": { "type": "string", "maxLength": 40 },
        "registrationTimeEat": { "type": "string", "maxLength": 30 },
        "courseFeeEtb": { "type": "number" },
        "paymentPlanCode": { "type": "string", "maxLength": 30 },
        "registrationStatus": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "registeredBy": { "type": "string", "maxLength": 128 },
        "registeredByName": { "type": "string", "maxLength": 120 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedByName": { "type": "string", "maxLength": 120 },
        "approvedAt": { "type": "string", "maxLength": 40 },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentCode", "fullName", "gender", "phone", "address", "courseId", "courseName", "enrollmentDate", "courseFeeEtb", "paymentPlanCode", "registrationStatus", "registeredBy", "createdAt", "updatedAt"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Student enrollment linking student, course, fee obligation, and payment plan.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 120 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseName": { "type": "string", "maxLength": 120 },
        "instructorId": { "type": "string", "maxLength": 128 },
        "paymentPlanCode": { "type": "string", "maxLength": 30 },
        "paymentPlanName": { "type": "string", "maxLength": 80 },
        "enrollmentDate": { "type": "string", "maxLength": 20 },
        "agreedFeeEtb": { "type": "number" },
        "approvedPaidEtb": { "type": "number" },
        "remainingBalanceEtb": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "ACTIVE", "COMPLETED", "REJECTED"] },
        "registeredBy": { "type": "string", "maxLength": 128 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentCode", "studentName", "courseId", "courseName", "paymentPlanCode", "enrollmentDate", "agreedFeeEtb", "approvedPaidEtb", "remainingBalanceEtb", "status", "registeredBy", "createdAt", "updatedAt"]
    },
    "PaymentInstallment": {
      "title": "PaymentInstallment",
      "description": "Scheduled fee installment row for an enrollment.",
      "type": "object",
      "properties": {
        "enrollmentId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 120 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseName": { "type": "string", "maxLength": 120 },
        "installmentNumber": { "type": "number" },
        "dueDate": { "type": "string", "maxLength": 20 },
        "amountDueEtb": { "type": "number" },
        "amountPaidEtb": { "type": "number" },
        "status": { "type": "string", "enum": ["UNPAID", "PARTIAL", "PAID", "OVERDUE"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["enrollmentId", "studentId", "studentCode", "studentName", "courseId", "courseName", "installmentNumber", "dueDate", "amountDueEtb", "amountPaidEtb", "status", "createdAt", "updatedAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Student fee payment submission requiring admin approval before affecting balances.",
      "type": "object",
      "properties": {
        "transactionRef": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9\\-_]+$" },
        "enrollmentId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 120 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseName": { "type": "string", "maxLength": 120 },
        "amountEtb": { "type": "number" },
        "paymentDate": { "type": "string", "maxLength": 20 },
        "paymentMethod": { "type": "string", "enum": ["Cash", "CBE Birr", "Telebirr", "Bank Transfer", "Check"] },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "recordedByName": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedByName": { "type": "string", "maxLength": 120 },
        "approvalDate": { "type": "string", "maxLength": 40 },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "receiptId": { "type": "string", "maxLength": 128 },
        "receiptNumber": { "type": "string", "maxLength": 40 },
        "notes": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["transactionRef", "enrollmentId", "studentId", "studentCode", "studentName", "courseId", "courseName", "amountEtb", "paymentDate", "paymentMethod", "recordedBy", "recordedByName", "status", "createdAt", "updatedAt"]
    },
    "PaymentRef": {
      "title": "PaymentRef",
      "description": "Unique index lock preventing duplicate transaction references.",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string", "maxLength": 128 },
        "transactionRef": { "type": "string", "maxLength": 64 },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["paymentId", "transactionRef", "recordedBy", "createdAt"]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Official immutable payment receipt generated strictly for approved payments.",
      "type": "object",
      "properties": {
        "receiptNumber": { "type": "string", "maxLength": 40 },
        "paymentId": { "type": "string", "maxLength": 128 },
        "transactionRef": { "type": "string", "maxLength": 64 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 120 },
        "studentPhone": { "type": "string", "maxLength": 30 },
        "courseName": { "type": "string", "maxLength": 120 },
        "previousBalanceEtb": { "type": "number" },
        "amountPaidEtb": { "type": "number" },
        "remainingBalanceEtb": { "type": "number" },
        "paymentDate": { "type": "string", "maxLength": 20 },
        "paymentMethod": { "type": "string", "maxLength": 40 },
        "authorizedBy": { "type": "string", "maxLength": 120 },
        "verificationHash": { "type": "string", "maxLength": 80 },
        "issuedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["receiptNumber", "paymentId", "transactionRef", "studentId", "studentCode", "studentName", "courseName", "previousBalanceEtb", "amountPaidEtb", "remainingBalanceEtb", "paymentDate", "paymentMethod", "authorizedBy", "verificationHash", "issuedAt"]
    },
    "ExpenseCategory": {
      "title": "ExpenseCategory",
      "description": "Accounting expense category.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 240 },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "isActive"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Institutional expense entry in ETB.",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 80 },
        "title": { "type": "string", "maxLength": 140 },
        "amountEtb": { "type": "number" },
        "expenseDate": { "type": "string", "maxLength": 20 },
        "paymentMethod": { "type": "string", "enum": ["Cash", "CBE Birr", "Telebirr", "Bank Transfer", "Check"] },
        "referenceNo": { "type": "string", "maxLength": 64 },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "recordedByName": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["categoryId", "categoryName", "title", "amountEtb", "expenseDate", "paymentMethod", "recordedBy", "recordedByName", "createdAt"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily student attendance record recorded by instructors or admins.",
      "type": "object",
      "properties": {
        "enrollmentId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 120 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseName": { "type": "string", "maxLength": 120 },
        "attendanceDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["PRESENT", "ABSENT", "LATE", "EXCUSED"] },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "recordedByName": { "type": "string", "maxLength": 120 },
        "remarks": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["enrollmentId", "studentId", "studentCode", "studentName", "courseId", "courseName", "attendanceDate", "status", "recordedBy", "recordedByName", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Role-targeted, user-targeted, or student-specific alert for deadlines, payments, courses, attendance, and messages.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["DEADLINE_APPROACHING", "OVERDUE_BALANCE", "PENDING_REGISTRATION", "PENDING_PAYMENT", "REJECTED_PAYMENT", "UPCOMING_PAYMENT", "PAYMENT_DUE_TODAY", "PAYMENT_OVERDUE", "PAYMENT_RECEIVED", "PAYMENT_APPROVED", "PAYMENT_REJECTED", "OUTSTANDING_BALANCE", "REGISTRATION_APPROVED", "COURSE_ANNOUNCEMENT", "ATTENDANCE_UPDATE", "INSTRUCTOR_MESSAGE", "ADMIN_ANNOUNCEMENT", "SCHEDULE_CHANGE", "NEW_INTERNAL_MESSAGE"] },
        "title": { "type": "string", "maxLength": 140 },
        "message": { "type": "string", "maxLength": 420 },
        "targetRole": { "type": "string", "enum": ["ADMIN", "ACCOUNTANT", "INSTRUCTOR", "GENERAL_STAFF", "STUDENT", "ALL"] },
        "recipientUid": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 40 },
        "actionSection": { "type": "string", "maxLength": 40 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 120 },
        "courseName": { "type": "string", "maxLength": 120 },
        "expectedAmountEtb": { "type": "number" },
        "paidAmountEtb": { "type": "number" },
        "remainingBalanceEtb": { "type": "number" },
        "dueDate": { "type": "string", "maxLength": 20 },
        "paymentStatus": { "type": "string", "maxLength": 30 },
        "dedupKey": { "type": "string", "maxLength": 128 },
        "entityType": { "type": "string", "maxLength": 40 },
        "entityId": { "type": "string", "maxLength": 128 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "title", "message", "targetRole", "isRead", "createdAt"]
    },
    "NotificationPreference": {
      "title": "NotificationPreference",
      "description": "Per-user delivery preferences for In-App, Email, SMS, and WhatsApp reminders.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "inAppEnabled": { "type": "boolean" },
        "emailEnabled": { "type": "boolean" },
        "smsEnabled": { "type": "boolean" },
        "whatsappEnabled": { "type": "boolean" },
        "upcomingLeadDays": { "type": "number" },
        "overdueRepeatDays": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "inAppEnabled", "emailEnabled", "smsEnabled", "whatsappEnabled", "upcomingLeadDays", "overdueRepeatDays", "updatedAt"]
    },
    "SmsConfig": {
      "title": "SmsConfig",
      "description": "Non-secret SMS gateway configuration and owner contact number managed by Admin.",
      "type": "object",
      "properties": {
        "ownerPhoneNumber": { "type": "string", "maxLength": 30 },
        "activeProvider": { "type": "string", "enum": ["afromessage", "geezsms", "twilio", "africastalking"] },
        "senderId": { "type": "string", "maxLength": 30 },
        "smsEnabled": { "type": "boolean" },
        "portalNotificationsEnabled": { "type": "boolean" },
        "internalMessagingEnabled": { "type": "boolean" },
        "testMode": { "type": "boolean" },
        "allowStudentToInstructor": { "type": "boolean" },
        "allowStudentToAdmin": { "type": "boolean" },
        "allowStudentToStudent": { "type": "boolean" },
        "allowAttachments": { "type": "boolean" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedByName": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerPhoneNumber", "activeProvider", "smsEnabled", "portalNotificationsEnabled", "internalMessagingEnabled", "testMode", "allowStudentToInstructor", "allowStudentToAdmin", "allowStudentToStudent", "allowAttachments", "updatedAt"]
    },
    "CommunicationPolicy": {
      "title": "CommunicationPolicy",
      "description": "Non-PII system-wide messaging and portal notification feature flags readable by all signed-in users.",
      "type": "object",
      "properties": {
        "portalNotificationsEnabled": { "type": "boolean" },
        "internalMessagingEnabled": { "type": "boolean" },
        "allowStudentToInstructor": { "type": "boolean" },
        "allowStudentToAdmin": { "type": "boolean" },
        "allowStudentToStudent": { "type": "boolean" },
        "allowAttachments": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["portalNotificationsEnabled", "internalMessagingEnabled", "allowStudentToInstructor", "allowStudentToAdmin", "allowStudentToStudent", "allowAttachments", "updatedAt"]
    },
    "SmsTemplate": {
      "title": "SmsTemplate",
      "description": "Editable SMS message template per institutional event type.",
      "type": "object",
      "properties": {
        "eventType": { "type": "string", "enum": ["REGISTRATION_APPROVED", "PAYMENT_REMINDER", "PAYMENT_OVERDUE", "PAYMENT_APPROVED", "COURSE_ANNOUNCEMENT", "ATTENDANCE_UPDATE", "INSTRUCTOR_MESSAGE", "ADMIN_ANNOUNCEMENT"] },
        "name": { "type": "string", "maxLength": 100 },
        "body": { "type": "string", "maxLength": 640 },
        "isActive": { "type": "boolean" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventType", "name", "body", "isActive", "updatedAt"]
    },
    "SmsLog": {
      "title": "SmsLog",
      "description": "Auditable SMS delivery log with event deduplication key and retry counter.",
      "type": "object",
      "properties": {
        "dedupKey": { "type": "string", "maxLength": 160 },
        "eventType": { "type": "string", "enum": ["REGISTRATION_APPROVED", "PAYMENT_REMINDER", "PAYMENT_OVERDUE", "PAYMENT_APPROVED", "COURSE_ANNOUNCEMENT", "ATTENDANCE_UPDATE", "INSTRUCTOR_MESSAGE", "ADMIN_ANNOUNCEMENT"] },
        "recipientName": { "type": "string", "maxLength": 120 },
        "recipientPhone": { "type": "string", "maxLength": 30 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "courseName": { "type": "string", "maxLength": 120 },
        "templateId": { "type": "string", "maxLength": 128 },
        "messageBody": { "type": "string", "maxLength": 640 },
        "provider": { "type": "string", "enum": ["afromessage", "geezsms", "twilio", "africastalking"] },
        "mode": { "type": "string", "enum": ["LIVE", "TEST"] },
        "status": { "type": "string", "enum": ["PENDING", "SENT", "DELIVERED", "FAILED", "TEST_SIMULATED"] },
        "providerMessageId": { "type": "string", "maxLength": 160 },
        "errorMessage": { "type": "string", "maxLength": 400 },
        "retryCount": { "type": "number" },
        "sentBy": { "type": "string", "maxLength": 128 },
        "sentByName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventType", "recipientName", "recipientPhone", "messageBody", "provider", "mode", "status", "retryCount", "sentBy", "sentByName", "createdAt", "updatedAt"]
    },
    "NotificationChannelRule": {
      "title": "NotificationChannelRule",
      "description": "Centralized channel matrix controlling SMS, Portal, and Internal Message dispatch per event.",
      "type": "object",
      "properties": {
        "eventType": { "type": "string", "enum": ["REGISTRATION_APPROVED", "PAYMENT_REMINDER", "PAYMENT_OVERDUE", "PAYMENT_APPROVED", "COURSE_ANNOUNCEMENT", "ATTENDANCE_UPDATE", "INSTRUCTOR_MESSAGE", "ADMIN_ANNOUNCEMENT"] },
        "label": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 240 },
        "smsEnabled": { "type": "boolean" },
        "portalEnabled": { "type": "boolean" },
        "internalMessageEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventType", "label", "description", "smsEnabled", "portalEnabled", "internalMessageEnabled", "updatedAt"]
    },
    "DirectoryUser": {
      "title": "DirectoryUser",
      "description": "PII-isolated messaging directory entry (no email, phone, or address) for internal chat discovery and presence.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["ADMIN", "ACCOUNTANT", "INSTRUCTOR", "GENERAL_STAFF", "STUDENT"] },
        "linkedStudentId": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseName": { "type": "string", "maxLength": 120 },
        "isActive": { "type": "boolean" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "role", "isActive", "lastSeenAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct, Group, or Broadcast internal messaging thread with strict participant isolation.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["DIRECT", "GROUP", "BROADCAST"] },
        "title": { "type": "string", "maxLength": 140 },
        "description": { "type": "string", "maxLength": 300 },
        "participantIds": { "type": "array", "description": "Bounded participant UID list (<= 200)." },
        "participantLabels": { "type": "array", "description": "Bounded display labels (uid|name|role)." },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseName": { "type": "string", "maxLength": 120 },
        "broadcastAudience": { "type": "string", "enum": ["ALL_USERS", "ALL_STUDENTS", "ALL_INSTRUCTORS", "ALL_ACCOUNTANTS", "ALL_STAFF", "COURSE", "CUSTOM"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 120 },
        "createdByRole": { "type": "string", "enum": ["ADMIN", "ACCOUNTANT", "INSTRUCTOR", "GENERAL_STAFF", "STUDENT"] },
        "lastMessageText": { "type": "string", "maxLength": 300 },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "lastMessageBy": { "type": "string", "maxLength": 128 },
        "lastMessageByName": { "type": "string", "maxLength": 120 },
        "readByUids": { "type": "array", "description": "Bounded UIDs that have read the latest message." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "title", "participantIds", "participantLabels", "createdBy", "createdByName", "createdByRole", "readByUids", "createdAt", "updatedAt"]
    },
    "InternalMessage": {
      "title": "InternalMessage",
      "description": "Individual message inside a conversation with optional reply context and validated file attachment.",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 120 },
