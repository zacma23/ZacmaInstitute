        "appliedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["version", "name", "appliedBy", "appliedByName", "status", "appliedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Append-only immutable audit trail for financial and governance actions.",
      "type": "object",
      "properties": {
        "actorId": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 120 },
