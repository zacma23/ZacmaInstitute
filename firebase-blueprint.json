        "summary": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorId", "actorName", "actorRole", "action", "entityType", "entityId", "summary", "createdAt"]
    },
    "FinancialAdjustment": {
      "title": "FinancialAdjustment",
      "description": "Immutable Admin-approved refund, reversal, scholarship discount, or fee adjustment entry (never deletes approved payments).",
      "type": "object",
      "properties": {
        "adjustmentRef": { "type": "string", "maxLength": 64 },
        "enrollmentId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 120 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseName": { "type": "string", "maxLength": 120 },
        "paymentId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["REFUND", "REVERSAL", "SCHOLARSHIP_DISCOUNT", "FEE_ADJUSTMENT"] },
        "amountEtb": { "type": "number" },
        "effectiveDate": { "type": "string", "maxLength": 20 },
        "reason": { "type": "string", "maxLength": 400 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedByName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adjustmentRef", "enrollmentId", "studentId", "studentCode", "studentName", "courseId", "courseName", "type", "amountEtb", "effectiveDate", "reason", "approvedBy", "approvedByName", "createdAt"]
    },
    "SecurityConfig": {
      "title": "SecurityConfig",
      "description": "Institutional inactivity auto-logout timeouts, lockout thresholds, and export audit settings managed by Admin.",
      "type": "object",
      "properties": {
        "adminTimeoutMinutes": { "type": "number" },
        "userTimeoutMinutes": { "type": "number" },
        "warningBeforeSeconds": { "type": "number" },
        "maxFailedLogins": { "type": "number" },
        "lockoutMinutes": { "type": "number" },
        "enforceAuditOnExports": { "type": "boolean" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedByName": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminTimeoutMinutes", "userTimeoutMinutes", "warningBeforeSeconds", "maxFailedLogins", "lockoutMinutes", "enforceAuditOnExports", "updatedAt"]
    },
    "LoginHistory": {
      "title": "LoginHistory",
      "description": "Append-only authentication and session lifecycle audit log.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "fullName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["ADMIN", "ACCOUNTANT", "INSTRUCTOR", "GENERAL_STAFF", "STUDENT"] },
        "eventType": { "type": "string", "enum": ["LOGIN", "LOGOUT", "SESSION_EXPIRED", "FAILED_LOGIN", "LOCKOUT"] },
        "authMethod": { "type": "string", "enum": ["EMAIL_PASSWORD", "GOOGLE", "SYSTEM"] },
        "userAgent": { "type": "string", "maxLength": 240 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "detail": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "fullName", "role", "eventType", "authMethod", "createdAt"]
    }
  },
